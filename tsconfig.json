{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"isolatedModules": true,
		"types": ["node", "jest"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts"
	],
	"exclude": [
		"tests/**/*",
		"**/*.test.ts",
		"**/*.spec.ts",
		"**/__tests__/**/*"
	]
}
